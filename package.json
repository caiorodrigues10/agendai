{
  "name": "agendai",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "audit:frontend-structure": "node scripts/audit-frontend-structure.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "docs:check": "node scripts/check-docs.mjs",
    "postinstall": "node scripts/patch-storybook-compat.mjs",
    "contract:check": "node scripts/check-api-contract.mjs",
    "contract:check:strict": "node scripts/check-api-contract.mjs --strict",
    "test:contract": "node --test scripts/check-api-contract.test.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:visual": "node scripts/run-visual-tests.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@hookform/resolvers": "^3.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "react": "18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "18.3.1",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
