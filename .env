# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Public key (NÃO é o access token!) usada pelo SDK do Mercado Pago no browser
# para tokenizar cartões. Obtenha em: https://www.mercadopago.com.br/developers/panel
# Deve ser o par da MERCADOPAGO_ACCESS_TOKEN configurada no backend.
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-xxxx-xxxx

# ─── Asaas ────────────────────────────────────────────────────────────────────
# Base da API pública do Asaas usada para tokenizar cartões no navegador.
# Sandbox (token hmlg): https://sandbox.asaas.com/api/v3
VITE_ASAAS_API_BASE=https://sandbox.asaas.com/api/v3

# ─── Google OAuth (SSO) ───────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ─── API ──────────────────────────────────────────────────────────────────────
# A base da API NÃO é configurada por variável: o app chama caminhos relativos
# ("/api/...") e o dev server do Vite faz proxy para http://localhost:3333
# (ver vite.config.ts → server.proxy). Em produção, sirva o frontend atrás do
# mesmo domínio/reverse-proxy que expõe a API em /api.
