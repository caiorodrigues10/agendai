# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Public key (NÃO é o access token!) usada pelo SDK do Mercado Pago no browser
# para tokenizar cartões. Obtenha em: https://www.mercadopago.com.br/developers/panel
# Deve ser o par da MERCADOPAGO_ACCESS_TOKEN configurada no backend.
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-xxxx-xxxx

# ─── Asaas ────────────────────────────────────────────────────────────────────
# Cartão Asaas é processado no backend (POST /subscriptions) — não há tokenização
# no browser. Esta variável não é mais usada pelo frontend; pode ser removida.
# VITE_ASAAS_API_BASE=

# ─── Google OAuth (SSO — login via Google Identity Services) ──────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (tipo Web application)
# Mesmo Client ID usado no backend (GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# ─── reCAPTCHA v3 ───────────────────────────────────────────────────────────
VITE_RECAPTCHA_SITE_KEY=

# ─── API ──────────────────────────────────────────────────────────────────────
# URL base do backend. Em dev, o Vite proxy redireciona /api → localhost:3333.
# Em produção (Render Static Site), DEVE ser a URL completa do backend.
# Ex: VITE_API_URL=https://agendai-back-end.onrender.com
VITE_API_URL=

# ─── Site público ─────────────────────────────────────────────────────────────
# Origem pública do site (SEM barra final). Usada em canonical/sitemap e no link
# de compartilhamento do perfil /s/salon/:id (buildProfileShareUrl). Precisa ser a
# MESMA origem da env PUBLIC_APP_URL do backend e o host precisa reescrever /s/*
# para a API (ver docs/agents/BUSINESS_RULES.md, seção "Ativação em staging").
# Sem capa, o og:image da prévia vem de <PUBLIC_API_URL do back>/api/... — se essa
# origem não expuser /api, configure PUBLIC_API_URL no back. Vazio = window.location.origin.
VITE_PUBLIC_SITE_URL=
